# Copy this file to .env and fill in real values before running any live demo.
#
# Every live demo in this app needs OPENAI_API_KEY. Only the Langfuse page
# additionally needs the two LANGFUSE_* keys below - every other page runs
# on OPENAI_API_KEY alone.

# --- Used by every framework's live demo on this page ---
OPENAI_API_KEY=

# --- Optional: only needed for the LangSmith live demo ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-frameworks

# --- Optional: only needed for the Langfuse live demo (score-and-push) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
