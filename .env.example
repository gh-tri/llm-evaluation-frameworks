# Copy this file to .env and fill in real values when you're ready to run the
# real-framework adapters (ragas, deepeval, trulens) and/or the LangSmith /
# Langfuse tracing integrations.
#
# Nothing in this project reads these until you explicitly opt in - the mock
# adapters and all six stations run with zero keys set. This file is only
# consulted by the "real" adapters and the observability tracing wrappers.

# --- Used by real_ragas.py, real_deepeval.py, real_trulens.py ---
# All three call an OpenAI model as the LLM judge by default.
OPENAI_API_KEY=

# --- Optional: only needed for the LangSmith tracing/observability demo ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eval-llm

# --- Optional: only needed for the Langfuse tracing/observability demo ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
